# Copy to .env (or export these in your shell) and fill in real values.
# .env is gitignored — never commit real secrets.

DB_URL=jdbc:mysql://localhost:3306/FoodWaste
DB_USERNAME=root
DB_PASSWORD=change-me

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-32-byte-plus-string
JWT_EXPIRATION_MS=36000000

CORS_ALLOWED_ORIGINS=http://localhost:4200
